# Knowledge local/deployment configuration template.
# Copy to .env (already ignored by git) and replace secrets before use.

# --- Application -------------------------------------------------------------
# Any value other than "development" enables the startup guard: it refuses to
# boot with placeholder JWT_SECRET, DEBUG=true, mock providers, or a
# JWT-derived TOKEN_ENCRYPTION_SECRET. Set real values before changing this.
APP_ENV=development
DEBUG=true
# Production must set a long random value; never use the example value.
JWT_SECRET=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# PostgreSQL is required by the API and worker. Use a separate database for tests.
DATABASE_URL=postgresql://knowledge:knowledge@127.0.0.1:5432/knowledge?gssencmode=disable

# Optional YeYing identity service. Leave empty to use local/demo login.
IDENTITY_NODE_URL=
IDENTITY_APP_ID=
# Must exactly match a redirect URI registered for this application.
IDENTITY_REDIRECT_URI=http://127.0.0.1:8000/auth/identity/callback
SIWE_DOMAIN=
SIWE_URI=
SIWE_CHAIN_ID=1

# --- Warehouse ---------------------------------------------------------------
# Standard S3-compatible object storage endpoint. Local Warehouse exposes S3 on 6066.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:6066
OBJECT_STORAGE_REGION=us-east-1
# Legacy WebDAV compatibility settings, only needed by transitional tooling.
WAREHOUSE_BASE_URL=http://127.0.0.1:6065
WAREHOUSE_WEBDAV_PREFIX=/dav
# Test-only local filesystem fallback; do not use as a production data plane.
WAREHOUSE_MOCK_ROOT=.mock_warehouse
# Used to encrypt Warehouse credentials stored in Knowledge.
# Set a stable random value in shared environments; empty derives from JWT_SECRET.
TOKEN_ENCRYPTION_SECRET=

# --- Vector and model providers ---------------------------------------------
# db is simplest for local development. Use weaviate for a dedicated vector service.
VECTOR_STORE_MODE=db
WEAVIATE_URL=http://127.0.0.1:8080
WEAVIATE_INDEX_NAME=KnowledgeChunk
# Separate class for unit-level (evidence/formal) vectors used by hybrid retrieval.
WEAVIATE_UNIT_INDEX_NAME=KnowledgeUnit
WEAVIATE_SCHEME=http
WEAVIATE_HOST=127.0.0.1
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=
# mock keeps local tests self-contained. Production must use a real model gateway.
MODEL_PROVIDER_MODE=mock
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
ANALYSIS_PLANNER_MODEL=gpt-4o-mini
ANALYSIS_PLANNER_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
# Must match the selected embedding provider; local mock/DB baseline is 32.
EMBEDDING_DIMENSIONS=32

# --- Ingestion and source connectors ----------------------------------------
DOCUMENT_PARSER_MODE=local
RAGFLOW_PARSER_CHUNK_TOKEN_NUM=512
RAGFLOW_PARSER_DELIMITER=\n!?;。；！？
DOCUMENT_CHUNKER_MODE=local
RAGFLOW_CHUNKER_DELIMITER=\n。；！？
SOURCE_CONNECTOR_MODE=warehouse
LOCAL_FILE_CONNECTOR_ROOT=.local_source_files
GITHUB_CONNECTOR_ACCESS_TOKEN=
GITHUB_CONNECTOR_API_BASE_URL=https://api.github.com

# --- Retrieval and worker ----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
# Hybrid retrieval fuses lexical + semantic ranks (RRF). Effective only with a real
# embedding provider; the mock provider is skipped so lexical ranking stays deterministic.
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RRF_K=60
# Unit-level vector candidates recalled (before fusion) to widen lexical recall.
RETRIEVAL_VECTOR_TOP_K=20
# Rerank re-scores the top fused candidates with a cross-encoder for precision.
# Default on; effective only with a real provider, any failure/timeout degrades to RRF.
RETRIEVAL_RERANK_ENABLED=true
RERANK_MODEL=rerank-english-v3.0
RERANK_TOP_M=20
RERANK_TIMEOUT_SECONDS=10
MEMORY_TOP_K=4
AUTO_MEMORY_SHORT_TERM_TTL_HOURS=72
AUTO_MEMORY_MAX_LONG_TERMS=3
AUTO_MEMORY_MAX_SHORT_TERMS=4
AUTO_MEMORY_RECENT_TURN_MAX_CHARS=600
# API and worker must share DATABASE_URL and this environment.
WORKER_NAME=knowledge-worker-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_RUN_LEASE_TTL_SECONDS=120
WORKER_TASK_CONCURRENCY=2
WORKER_MAX_ACTIVE_TASKS_PER_USER=1
WORKER_TASK_HEARTBEAT_INTERVAL_SECONDS=15
